{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022",
      "ESNext.Disposable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": [
      "vitest/globals",
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
